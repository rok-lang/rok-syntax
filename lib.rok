// Tokenizer and HTML highlighter for rok and ROKON: keywords, types,
// strings (f-string holes as code, nested), chars, numbers, comments
// and attributes.

/// What a token is. `Text` is everything else (identifiers, operators,
/// punctuation, whitespace).
#[derive(Clone, PartialEq, Eq, Debug)]
pub enum Kind {
    Keyword,
    Type,
    Str,
    Number,
    Comment,
    Attribute,
    Text,
}

impl Kind {
    /// The CSS class `highlight_*` puts on the token's `<span>`: `k`,
    /// `t`, `s`, `n`, `c`, `a`, or `""` for `Text` (not wrapped).
    pub fn class(self) -> str {
        match self {
            Kind::Keyword => "k",
            Kind::Type => "t",
            Kind::Str => "s",
            Kind::Number => "n",
            Kind::Comment => "c",
            Kind::Attribute => "a",
            Kind::Text => "",
        }
    }
}

/// A slice of the source. Concatenating the `text` of all tokens gives
/// the source back.
#[derive(Clone, Debug)]
pub struct Token {
    pub kind: Kind;
    pub text: str;
}

const KEYWORDS: [str; 47] = [
    "let", "fn", "if", "else", "match", "while", "loop", "for", "return", "break", "continue",
    "try", "throw", "async", "await", "yield", "unsafe", "using", "struct", "enum", "trait",
    "impl", "pub", "mod", "use", "as", "is", "ref", "true", "false", "none", "self", "Self",
    "type", "any", "in", "where", "throws", "rethrows", "catch", "finally", "const", "static",
    "extern", "mut", "union", "pkg",
];

const ROKON_KEYWORDS: [str; 3] = ["true", "false", "none"];

const TYPES: [str; 19] = [
    "i8", "i16", "i32", "i64", "i128", "isize", "u8", "u16", "u32", "u64", "u128", "usize",
    "f32", "f64", "bool", "char", "str", "int", "float",
];

/// Tokens of rok source.
pub fn tokens(src: str) -> List<Token> { lex(src, false) }

/// Tokens of ROKON source: as rok, but only `true` / `false` / `none`
/// are keywords.
pub fn tokens_rokon(src: str) -> List<Token> { lex(src, true) }

/// rok source as HTML: tokens as `<span class="..">` (see
/// `Kind::class`), `&` / `<` / `>` escaped. Goes inside `<pre><code>`.
pub fn highlight_rok(src: str) -> str { to_html(tokens(src)) }

/// ROKON source as HTML, as `highlight_rok`.
pub fn highlight_rokon(src: str) -> str { to_html(tokens_rokon(src)) }

/// Tokens as HTML, as `highlight_rok`.
pub fn to_html(toks: List<Token>) -> str {
    let out = StrBuf::new();
    for t in toks {
        let cls = t.kind.class();
        if cls.is_empty() {
            esc_into(out, t.text);
        } else {
            out.push_str(f"<span class=\"{cls}\">");
            esc_into(out, t.text);
            out.push_str("</span>");
        }
    }
    out.to_str()
}

fn esc_into(out: StrBuf, s: str) {
    for c in s.chars() {
        if c == '&' {
            out.push_str("&amp;");
        } else if c == '<' {
            out.push_str("&lt;");
        } else if c == '>' {
            out.push_str("&gt;");
        } else {
            out.push(c);
        }
    }
}

fn is_ident(c: char) -> bool { c.is_alphanumeric() || c == '_' }

fn lex(src: str, rokon: bool) -> List<Token> {
    let cs: List<char> = List::new();
    for c in src.chars() { cs.push(c); }
    let lx = Lexer { cs: cs, rokon: rokon, toks: List::new(), text: StrBuf::new() };
    lx.code(0, false);
    lx.flush();
    lx.toks
}

struct Lexer {
    cs: List<char>;
    rokon: bool;
    toks: List<Token>;
    /// Pending `Text`, merged until the next other token.
    text: StrBuf;
}

impl Lexer {
    fn flush(self) {
        if self.text.is_empty() { return; }
        self.toks.push(Token { kind: Kind::Text, text: self.text.to_str() });
        self.text.clear();
    }

    fn plain(self, c: char) { self.text.push(c); }

    fn emit(self, kind: Kind, a: usize, b: usize) {
        if a >= b { return; }
        self.flush();
        let s = StrBuf::new();
        for k in a..b { s.push(self.cs[k]); }
        self.toks.push(Token { kind: kind, text: s.to_str() });
    }

    fn is_keyword(self, w: str) -> bool {
        if self.rokon {
            for k in ROKON_KEYWORDS {
                if k == w { return true; }
            }
            return false;
        }
        for k in KEYWORDS {
            if k == w { return true; }
        }
        false
    }

    /// End of the quoted literal starting at `i` (`"` or `'`).
    fn quote_end(self, i: usize, q: char) -> usize {
        let cs = self.cs;
        let k = i + 1;
        while k < cs.len() {
            let c = cs[k];
            if c == '\\' {
                k += 2;
                continue;
            }
            if c == q { return k + 1; }
            if c == '\n' && q == '\'' { return k; }
            k += 1;
        }
        cs.len()
    }

    /// An f-string from its `f` at `i`: text as `Str`, hole code as code
    /// (it may reuse the quote and nest f-strings). Returns its end.
    fn fstr(self, i: usize) -> usize {
        let cs = self.cs;
        let n = cs.len();
        let triple = i + 3 < n && cs[i + 2] == '"' && cs[i + 3] == '"';
        let k = if triple { i + 4 } else { i + 2 };
        let run = i;
        while k < n {
            let c = cs[k];
            let nx = if k + 1 < n { cs[k + 1] } else { ' ' };
            if c == '\\' || ((c == '{' || c == '}') && nx == c) {
                k += 2;
            } else if c == '"' && (!triple || (k + 2 < n && nx == '"' && cs[k + 2] == '"')) {
                let e = if triple { k + 3 } else { k + 1 };
                self.emit(Kind::Str, run, e);
                return e;
            } else if c == '{' {
                self.emit(Kind::Str, run, k + 1);
                k = self.hole(k + 1);
                run = k;
                if k < n { k += 1; }
            } else {
                k += 1;
            }
        }
        self.emit(Kind::Str, run, n);
        n
    }

    /// Hole code from `i`, then its spec (with nested `{..}` / `${..}`
    /// holes) as `Str`. Returns the index of the closing `}`.
    fn hole(self, i: usize) -> usize {
        let cs = self.cs;
        let n = cs.len();
        let k = self.code(i, true);
        if k >= n || cs[k] != ':' { return k; }
        let run = k;
        while k < n && cs[k] != '}' && cs[k] != '"' {
            let nx = if k + 1 < n { cs[k + 1] } else { ' ' };
            if cs[k] == '$' && nx == '$' {
                k += 2;
            } else if cs[k] == '{' || (cs[k] == '$' && nx == '{') {
                let open = if cs[k] == '$' { k + 2 } else { k + 1 };
                self.emit(Kind::Str, run, open);
                k = self.hole(open);
                run = k;
                if k < n { k += 1; }
            } else {
                k += 1;
            }
        }
        self.emit(Kind::Str, run, k);
        k
    }

    /// Code from `start`. In a hole, stop at its closing `}` or spec `:`
    /// (bracket depth 0) and return where; else run to the end.
    fn code(self, start: usize, in_hole: bool) -> usize {
        let cs = self.cs;
        let n = cs.len();
        let i = start;
        let depth = 0;
        while i < n {
            let c = cs[i];
            let nx = if i + 1 < n { cs[i + 1] } else { ' ' };
            if in_hole && depth == 0 && (c == '}' || (c == ':' && nx != ':')) {
                return i;
            }
            if c == '(' || c == '[' || c == '{' { depth += 1; }
            if c == ')' || c == ']' || c == '}' { depth -= 1; }
            if c == ':' && nx == ':' {
                self.plain(':');
                self.plain(':');
                i += 2;
            } else if c == '/' && nx == '/' {
                let k = i;
                while k < n && cs[k] != '\n' { k += 1; }
                self.emit(Kind::Comment, i, k);
                i = k;
            } else if c == '/' && nx == '*' {
                let k = i + 2;
                while k + 1 < n && !(cs[k] == '*' && cs[k + 1] == '/') { k += 1; }
                k = if k + 2 <= n { k + 2 } else { n };
                self.emit(Kind::Comment, i, k);
                i = k;
            } else if c == '"' {
                let k = self.quote_end(i, '"');
                self.emit(Kind::Str, i, k);
                i = k;
            } else if c == '\'' {
                // A char literal is short; anything else is text.
                let k = self.quote_end(i, '\'');
                if k <= i + 12 && k > i + 2 && cs[k - 1] == '\'' {
                    self.emit(Kind::Str, i, k);
                    i = k;
                } else {
                    self.plain(c);
                    i += 1;
                }
            } else if c == '#' && (nx == '[' || nx == '!') {
                let k = i;
                let d = 0;
                while k < n && cs[k] != '\n' {
                    if cs[k] == '[' { d += 1; }
                    if cs[k] == ']' {
                        d -= 1;
                        if d == 0 {
                            k += 1;
                            break;
                        }
                    }
                    k += 1;
                }
                self.emit(Kind::Attribute, i, k);
                i = k;
            } else if c.is_ascii_digit() {
                let k = i;
                while k < n && (is_ident(cs[k]) || (cs[k] == '.' && k + 1 < n && cs[k + 1].is_ascii_digit())) { k += 1; }
                self.emit(Kind::Number, i, k);
                i = k;
            } else if is_ident(c) {
                let k = i;
                while k < n && is_ident(cs[k]) { k += 1; }
                let w = StrBuf::new();
                for j in i..k { w.push(cs[j]); }
                let word = w.to_str();
                if k < n && cs[k] == '"' && word == "f" {
                    i = self.fstr(i);
                } else if k < n && cs[k] == '"' && (word == "r" || word == "b") {
                    let e = self.quote_end(k, '"');
                    self.emit(Kind::Str, i, e);
                    i = e;
                } else {
                    if self.is_keyword(word) {
                        self.emit(Kind::Keyword, i, k);
                    } else if is_type(word) {
                        self.emit(Kind::Type, i, k);
                    } else {
                        self.text.push_str(word);
                    }
                    i = k;
                }
            } else {
                self.plain(c);
                i += 1;
            }
        }
        n
    }
}

fn is_type(w: str) -> bool {
    for k in TYPES {
        if k == w { return true; }
    }
    let c = w.chars().next() ?? 'a';
    c.is_uppercase()
}

// ---- tests ----

#[cfg(test)]
fn expect(ok: bool, what: str) {
    if !ok { panic(f"check failed: {what}"); }
}

#[cfg(test)]
fn s(t: str) -> str { f"<span class=\"s\">{t}</span>" }

#[test]
fn highlights_rok() {
    let h = highlight_rok("let x: i32 = 1; // c\n#[test] Foo::bar('a', \"<\")");
    expect(h == "<span class=\"k\">let</span> x: <span class=\"t\">i32</span> = <span class=\"n\">1</span>; <span class=\"c\">// c</span>\n<span class=\"a\">#[test]</span> <span class=\"t\">Foo</span>::bar(<span class=\"s\">'a'</span>, <span class=\"s\">\"&lt;\"</span>)", h);
}

#[test]
fn fstring_holes() {
    let same = s("f\"{") + "s.split(" + s("\" \"") + ")" + s("}\"");
    expect(highlight_rok("f\"{s.split(\" \")}\"") == same, "same quote");
    let nested = s("f\"{") + s("f\"{") + "x" + s(":&gt;{") + "w" + s("}") + s("}\"") + s("} {{y}}\"");
    expect(highlight_rok("f\"{f\"{x:>{w}}\"} {{y}}\"") == nested, "nested");
}

#[test]
fn rokon_keywords() {
    let h = highlight_rokon("Package { type: \"x\", ok: true }");
    expect(h == "<span class=\"t\">Package</span> { type: <span class=\"s\">\"x\"</span>, ok: <span class=\"k\">true</span> }", h);
}

#[test]
fn tokens_round_trip() {
    let src = "fn f(a: str) -> str { f\"{a:>{w}}\" } /* x */ 'ab";
    let ts = tokens(src);
    let back = StrBuf::new();
    for t in ts { back.push_str(t.text); }
    expect(back.to_str() == src, "concat");
    expect(ts[0].kind == Kind::Keyword && ts[0].text == "fn", "first");
    expect(ts[1].kind == Kind::Text && ts[1].text == " f(a: ", "merged text");
}
