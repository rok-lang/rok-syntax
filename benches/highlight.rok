// Tokenize and highlight a large rok source (spec 9.9.11).

use rok::core::bench::Bench;
use rok::core::hint::black_box;
use pkg::{highlight_rok, tokens};

// ~1500 functions of mixed tokens (keywords, types, strings, f-strings,
// comments, attributes).
fn bench_src() -> str {
    let b = StrBuf::new();
    let i = 0i64;
    while i < 1500i64 {
        b.push_str(f"fn func_{i}(a: i32, b: str) -> i32 {{ let x = {i}; // comment\n");
        b.push_str("    let s = f\"{a:>{x}}\"; Foo::bar('c', \"text\"); x + 1 }\n");
        i += 1i64;
    }
    b.to_str()
}

#[bench]
fn highlight(b: Bench) {
    let s = bench_src();
    b.bytes(s.len() as i64);
    b.iter(|| highlight_rok(black_box(s)));
}

#[bench]
fn tokenize(b: Bench) {
    let s = bench_src();
    b.bytes(s.len() as i64);
    b.iter(|| tokens(black_box(s)));
}
