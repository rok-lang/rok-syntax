    },
    "type": {
      "patterns": [
        {
          "name": "support.type.primitive.rok",
          "match": "(?<![\\p{L}\\p{N}_])(?:i8|i16|i32|i64|i128|isize|u8|u16|u32|u64|u128|usize|f32|f64|bool|char|str|int|float|c_char)(?![\\p{L}\\p{N}_])"
        },
        {
