      ]
    },
    "function-call": {
      "name": "entity.name.function.call.rok",
      "match": "(?<![\\p{L}\\p{N}_])[\\p{L}_][\\p{L}\\p{N}\\p{M}_]*(?=\\s*\\()"
    },
    "operator": {
      "patterns": [
        {
          "name": "punctuation.separator.namespace.rok",
          "match": "::"
        },
        {
