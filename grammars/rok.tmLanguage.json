      ]
    },
    "impl-generic": {
      "name": "meta.generic.rok",
      "begin": "(?<![\\p{L}\\p{N}_])(impl)(<)",
      "end": ">",
      "beginCaptures": {
        "1": {
          "name": "storage.type.rok"
        },
        "2": {
          "name": "punctuation.definition.generic.begin.rok"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.generic.end.rok"
        }
      },
      "patterns": [
        {
          "include": "#generic-body"
        }
      ]
    },
    "generic-body": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "name": "meta.generic.rok",
          "begin": "(?<![\\p{L}\\p{N}_])(\\p{Lu}[\\p{L}\\p{N}_]*)(<)",
          "end": ">",
          "beginCaptures": {
            "1": {
              "name": "entity.name.type.rok"
            },
            "2": {
              "name": "punctuation.definition.generic.begin.rok"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.generic.end.rok"
            }
          },
          "patterns": [
            {
              "include": "#generic-body"
            }
