// Token classes: TextMate scope prefix (without the .rok / .rokon
// suffix), the Rok library's Kind, the tree-sitter capture, the LSP
// semantic token type. A scope takes the row of its longest listed
// prefix. Kind "" adds no Kind of its own; LSP "" means no LSP type.
// One tuple a line: the runners in scripts/ read this file with a
// regex. Keyword lists are in keywords.rokon.
[
    ("comment", "Comment", "comment", "comment"),
    ("comment.line.documentation", "Comment", "comment.documentation", "comment"),
    ("comment.block.documentation", "Comment", "comment.documentation", "comment"),
    ("comment.line.shebang", "Comment", "keyword.directive", "comment"),
    ("punctuation.definition.comment", "Comment", "comment", "comment"),
    ("string", "Str", "string", "string"),
    ("string.quoted.single", "Str", "character", "string"),
    ("storage.type.string", "Str", "string", "string"),
    ("punctuation.definition.string", "Str", "string", "string"),
    ("constant.character.escape", "Str", "string.escape", "string"),
    ("constant.other.format-spec", "Str", "string.special", "string"),
    ("punctuation.section.interpolation", "Str", "punctuation.special", ""),
    ("meta.interpolation", "Text", "embedded", ""),
    ("constant.numeric", "Number", "number", "number"),
    ("constant.numeric.float", "Number", "number.float", "number"),
    ("entity.name.type.numeric", "Number", "number", "number"),
    ("constant.language", "Keyword", "constant.builtin", "keyword"),
    ("constant.language.boolean", "Keyword", "boolean", "keyword"),
    ("keyword", "Keyword", "keyword", "keyword"),
    ("keyword.other.path", "Keyword", "module.builtin", "keyword"),
    ("keyword.other.template", "Macro", "function.macro", "macro"),
    ("keyword.operator", "Text", "operator", "operator"),
    ("keyword.operator.word", "Keyword", "keyword.operator", "keyword"),
    ("storage", "Keyword", "keyword", "keyword"),
    ("storage.type.function", "Keyword", "keyword.function", "keyword"),
    ("storage.modifier", "Keyword", "keyword.modifier", "keyword"),
    ("variable.language", "Keyword", "variable.builtin", "keyword"),
    ("variable", "Text", "variable", "variable"),
    ("variable.parameter", "Text", "variable.parameter", "parameter"),
    ("variable.other.member", "Text", "property", "property"),
    ("entity.name.type", "Type", "type", "type"),
    ("support.type", "Type", "type.builtin", "type"),
    ("support.type.property-name", "Text", "property", "property"),
    ("entity.name.function", "Text", "function", "function"),
    ("entity.name.function.call", "Text", "function.call", "function"),
    ("entity.name.function.macro", "Macro", "function.macro", "macro"),
    ("entity.name.function.attribute", "Attribute", "attribute", "decorator"),
    ("entity.name.namespace", "Text", "module", "namespace"),
    ("entity.name.label", "Text", "label", ""),
    ("meta", "", "", ""),
    ("meta.attribute", "Attribute", "attribute", "decorator"),
    ("punctuation", "Text", "punctuation", ""),
    ("punctuation.brackets", "Text", "punctuation.bracket", ""),
    ("punctuation.separator", "Text", "punctuation.delimiter", ""),
    ("punctuation.terminator", "Text", "punctuation.delimiter", ""),
    ("punctuation.accessor", "Text", "punctuation.delimiter", ""),
    ("punctuation.definition.attribute", "Attribute", "attribute", "decorator"),
    ("punctuation.definition.template", "Macro", "function.macro", "macro"),
    ("punctuation.definition.label", "Text", "label", ""),
    ("punctuation.definition.generic", "Text", "punctuation.bracket", ""),
    ("invalid", "", "error", ""),
]
