//                                    ^^^ keyword.operator.assignment.compound.rok
//                                             ^^^ keyword.operator.assignment.compound.rok
//                                                      ^^ keyword.operator.assignment.compound.rok
    a .+ b; a.+b; a .== b; a .&& b; a.%%b;
//    ^^ keyword.operator.broadcast.rok
//           ^^ keyword.operator.broadcast.rok
//                  ^^^ keyword.operator.broadcast.rok
//                           ^^^ keyword.operator.broadcast.rok
//                                   ^^^ keyword.operator.broadcast.rok
    x?.y ?? z; f()?; 0..n; 0..=n; a::b; |x| -> T { x }; match m { x => v };
//   ^^ keyword.operator.optional.rok
//     ^ variable.other.member.rok
//       ^^ keyword.operator.optional.rok
//                ^ keyword.operator.optional.rok
//                    ^^ keyword.operator.range.rok
