//                                                         ^^^^ keyword.operator.assignment.compound.rok
//                                                                   ^^^ keyword.operator.broadcast.rok
    f(x in xs, x !in 0..n, a < b <= c); (a, b) = (b, a); let e = try? f() ?? d;
//      ^^ keyword.control.rok
//               ^^^ keyword.operator.word.rok
//                    ^^ keyword.operator.range.rok
//                               ^^ keyword.operator.comparison.rok
//                                             ^ keyword.operator.assignment.rok
//                                                               ^^^ keyword.control.rok
