//          ^ punctuation.brackets.square.rok
//               ^ punctuation.brackets.curly.rok
//                       ^ punctuation.separator.colon.rok
//                          ^ punctuation.accessor.rok
    x ** 2; x **= 2; a .** b; a .?? b; -x**2;
//    ^^ keyword.operator.arithmetic.rok
//            ^^^ keyword.operator.assignment.compound.rok
//                     ^^^ keyword.operator.broadcast.rok
//                              ^^^ keyword.operator.broadcast.rok
//                                       ^^ keyword.operator.arithmetic.rok
    y .= x; y .+= x; y .-= x; y .*= x; y ./= x; y .%= x; y .**= x; y .== x;
//    ^^ keyword.operator.assignment.compound.rok
//            ^^^ keyword.operator.assignment.compound.rok
//                     ^^^ keyword.operator.assignment.compound.rok
