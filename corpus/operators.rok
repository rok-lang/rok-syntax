//                                      ^ keyword.operator.bitwise.rok
//                                          ^^ keyword.operator.arrow.rok
//                                                                  ^^ keyword.operator.arrow.rok
    a × b ⋅ c ÷ d ∘ e + √f; f(a ≡ b, a ≠ b, a ≤ b, a ≥ b, a ∈ b, a ∉ b, a ⊂ b, a ⊆ b, a ∪ b, a ∩ b);
